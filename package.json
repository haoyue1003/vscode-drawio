{
	"name": "hesds-modeling-design-tool",
	"private": true,
	"displayName": "hesds-modeling-design-tool",
	"description": "hesds-modeling-design-tool is a tool for creating 4+1 views",
	"version": "0.0.1",
	"license": "GPL-3.0",
	"publisher": "hesds",
	"keywords": [
		"drawio",
		"diagram",
		"diagrams.net",
		"visio",
		"architecture",
		"uml",
		"code link"
	],
	"author": {
		"email": "henning.dieterichs@live.de",
		"name": "Henning Dieterichs"
	},
	"readme": "./README.md",
	"icon": "docs/logo.5md.png",
	"extensionKind": [
		"ui",
		"workspace"
	],
	"engines": {
		"vscode": "^1.46.0"
	},
	"categories": [
		"Visualization"
	],
	"activationEvents": [
		"onCommand:hesds.4+1view.newDiagram",
		"workspaceContains:**/*.5md"
	],
	"repository": {
		"url": "https://github.com/hediet/vscode-drawio.git"
	},
	"browser": "./dist/extension/index",
	"main": "./dist/extension/index",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"languages": [
			{
				"id": "5md",
				"extensions": [
					".5md"
				],
				"aliases": [
					"5md",
					"5MD"
				]
			}
		],
		"customEditors": [
			{
				"viewType": "hesds.4+1view-text",
				"displayName": "5MD",
				"selector": [
					{
						"filenamePattern": "*.5md"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "hesds.4+1view.export",
				"title": "Export To...",
				"category": "hesds.uml"
			},
			{
				"command": "hesds.4+1view.newDiagram",
				"title": "New 4+1 View Diagram",
				"category": "hesds.uml"
			}
		],
		"keybindings": [
		],
		"configuration": {
			"title": "5MD Integration",
			"properties": {
				"hesds.4+1view.knownPlugins": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"pluginId": {
								"type": "string"
							},
							"fingerprint": {
								"type": "string"
							},
							"allowed": {
								"type": "boolean"
							}
						}
					},
					"default": [],
					"title": "Known Plugins"
				}
			}
		},
		"menus": {
			
		},
		"viewsContainers": {
		"activitybar": [
				{
				"id": "hesds-modeling-design-tool",
				"title": "4+1 视图建模工具",
				"icon": "docs/logo.5md.png"
				}
			]	
		}
		,
		"views": {
		"hesds-modeling-design-tool": [
			{
			"id": "hesds-modeling-design-tool.newMdView",
			"name": ""
			}
		]
		},
		"viewsWelcome": [
		{
			"view": "hesds-modeling-design-tool.newMdView",
			"contents": "1、支持开发视图、逻辑视图、物理视图、进程视图、场景视图等\n 2、提供多种内置模板便于用户快速创建符合业务需求的视图，包括：逻辑视图、进程视图、微服务架构、分层架构等模版\n  3、提供用户自定义模版，弥补内置模版不满足业务需求的情况下，可以定制属于自己专属业务的模版，方便后续快速建模\n   4、自动生成报告：class 图、interface 图自动生成docx模版，提高工作效率\n  5、支持xmi1.1标准的部分建模文件导入：用例图、时序图  \n\n确认创建模型\n\n[确认](command:hesds.4+1view.newDiagram)\n\n \n\n",
			"enablement": "!ConfirmVisible"
		}
    ]
	},
	"scripts": {
		"run-script": "node ./scripts/run-script", 
		"lint": "yarn run-script check-version && prettier --check ./src",
		"build": "yarn pre-build && vsce package --yarn --out ./vscode-drawio.vsix",
		"pre-build": "webpack --mode production && webpack --mode production --config ./drawio-custom-plugins/webpack.config.ts",
		"dev": "webpack --mode development --config ./drawio-custom-plugins/webpack.config.ts && webpack --mode development --config ./webpack.config.ts",
		"dev-drawio-plugins": "webpack --mode development --watch --config ./drawio-custom-plugins/webpack.config.ts",
		"dev-drawio-plugins-web": "webpack-dev-server --hot --config ./drawio-custom-plugins/webpack.config.ts"
	},
	"devDependencies": {
		"@actions/exec": "^1.0.4",
		"@actions/github": "^2.2.0",
		"@hediet/semver": "^0.2.1",
		"@types/copy-webpack-plugin": "^8.0.1",
		"@types/mithril": "^2.0.4",
		"@types/node": "^13.13.5",
		"@types/vscode": "1.46.0",
		"@types/xml-formatter": "^1.1.0",
		"clean-webpack-plugin": "^4.0.0-alpha.0",
		"copy-webpack-plugin": "^9.0.1",
		"css-loader": "^6.8.1",
		"less": "^4.3.0",
		"less-loader": "^12.3.0",
		"ovsx": "^0.8.3",
		"prettier": "^2.3.2",
		"raw-loader": "^4.0.1",
		"style-loader": "^1.1.3",
		"ts-loader": "^9.2.3",
		"ts-node": "^10.1.0",
		"tslint": "^6.1.2",
		"typescript": "^4.3.5",
		"vsce": "^2.15.0",
		"webpack": "^5.98.0",
		"webpack-cli": "^4.10.0",
		"webpack-dev-server": "^4.15.1"
	},
	"dependencies": {
		"@hediet/json-to-dictionary": "^0.2.1",
		"@hediet/std": "0.6.0",
		"@knuddels/mobx-logger": "^1.1.1",
		"@types/xmldom": "^0.1.34",
		"buffer": "^6.0.3",
		"docx": "^9.5.0",
		"glob": "^11.0.1",
		"js-sha256": "^0.9.0",
		"mithril": "^2.0.4",
		"mobx": "5.15.4",
		"mobx-utils": "5.5.7",
		"path-browserify": "^1.0.1",
		"vsls": "^1.0.3015",
		"xml-formatter": "^2.0.1",
		"xml-parser-xo": "^3.0.0",
		"xmldom": "^0.6.0"
	}
}
